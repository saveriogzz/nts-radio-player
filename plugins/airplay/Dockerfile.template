FROM mikebrady/shairport-sync:4.1.1
WORKDIR /usr/src

ENV DBUS_SYSTEM_BUS_ADDRESS=unix:path=/host/run/dbus/system_bus_socket
ENV PULSE_SERVER=tcp:audio:4317

SHELL ["/bin/sh", "-eo", "pipefail", "-c"]

# shairport-sync image doesn't include PulseAudio support; use ALSA bridge
RUN apk update && apk add --no-cache supervisor curl && \
  curl -skL https://raw.githubusercontent.com/balena-io-experimental/audio/master/scripts/alsa-bridge/alpine-setup.sh | sh \
  && apk del curl

COPY start.sh supervisor.conf /usr/src/

ENTRYPOINT []
CMD ["supervisord", "-c", "/usr/src/supervisor.conf"]
