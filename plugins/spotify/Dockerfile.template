# Multi-stage build: compile librespot from source with PulseAudio backend

# ── Build stage ──────────────────────────────────────────────
FROM balenalib/%%BALENA_MACHINE_NAME%%-debian:bookworm-build AS build

RUN install_packages \
    curl \
    git \
    pkg-config \
    libasound2-dev \
    libpulse-dev

# librespot v0.8.0 requires Rust edition 2024 (Rust 1.85+); apt's rustc is too old
ENV CARGO_HOME=/usr/local/cargo
ENV RUSTUP_HOME=/usr/local/rustup
ENV PATH="${CARGO_HOME}/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain stable --profile minimal

WORKDIR /usr/src
RUN git clone --branch v0.8.0 --depth 1 https://github.com/librespot-org/librespot.git
WORKDIR /usr/src/librespot
RUN cargo build --release --no-default-features --features pulseaudio-backend

# ── Runtime stage ────────────────────────────────────────────
FROM balenalib/%%BALENA_MACHINE_NAME%%-debian:bookworm-run

RUN install_packages \
    libpulse0 \
    libasound2

COPY --from=build /usr/src/librespot/target/release/librespot /usr/bin/librespot

ENV PULSE_SERVER=tcp:audio:4317

WORKDIR /usr/src
COPY start.sh ./

CMD [ "/bin/bash", "/usr/src/start.sh" ]
